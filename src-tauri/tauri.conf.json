{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roblox Animation Replacer",
  "version": "0.1.0",
  "identifier": "com.roblox.animationreplacer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Roblox Animation Replacer",
        "width": 1000,
        "height": 780,
        "minWidth": 800,
        "minHeight": 650,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
